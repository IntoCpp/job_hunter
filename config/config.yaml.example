# Job-Hunter production configuration template
# Copy to config/config.yaml and adjust paths for your environment.

posting_output: "C:/Users/ERIC/Documents/job_hunter_finds/"
posting_history: "C:/Users/ERIC/Documents/job_hunter_finds/posting_history.yaml"

search_profile:
  input_files:
    - "C:/path/to/master_resume.md"
    - "C:/path/to/master_resume_analysis_cache.json"
  output_file: "C:/path/to/job_search_profile.yaml"

resume_rework:
  script_path: "C:/Users/ERIC/Documents/Code/job-hunter-resume-rework/resume_rework.py"
  working_directory: "C:/Users/ERIC/Documents/Code/job-hunter-resume-rework"

confidence_resume: 0.90

models:
  agent: "gpt-4o-mini"
  profile: "gpt-4o-mini"
  ranking: "gpt-4o"
  location: "gpt-4o-mini"
  extraction: "gpt-4o-mini"

locations:
  - name: "Montreal Greater Area"
    description: "Montreal and surrounding areas accessible by public transport or reasonable commute"
  - name: "South Shore"
    description: "Longueuil, Brossard, Saint-Hubert, and nearby cities"

web_sites:
  companies:
    # Full URL — site root or a filtered sub-page (e.g. IT jobs only)
    - url: "https://emploi.hydroquebec.com/go/Technologies-information-et-communications/2661617/"
  job_boards:
    - name: "LinkedIn"
      domain: "linkedin.com"
    - name: "Indeed"
      domain: "ca.indeed.com"

search:
  provider: serper
